    scale_fill_manual(values = c("Downstream" = "blue", "Upstream" = "red", "Both" = "darkorchid1","No Info" = "grey50"), name = "Regulators") +
    scale_color_manual(values = c("PIDC"= "gold", "None" = "black"), 
                       name = "PIDC core") +
    #scale_size_manual(values = c())+
    scale_edge_color_manual(values = c("Stimulation" = "red", "Inhibition" = "blue", "Unknown" = "black"),
                            name = "Interaction Type") +
    theme_graph() + 
    ggtitle(plotTitle) +
    theme(text = element_text(family = "Times", size = 15), 
          plot.title = element_text(family = "Times", size = 20)) 
  
  return(list(graph = subgraph_g, plot = plot))
}
subset_cdc42_graph_by_distance<- function(graph, center = "Cdc42", distance = 2) {
  
  # 1. Find all vertices within 'distance' steps from 'center'
  #    If your graph is directed and you want out-neighbors only,
  #    use mode = "out". (Otherwise, for undirected or both directions, use mode = "all".)
  vertices_in_range <- neighborhood(
    graph, 
    order = distance, 
    nodes = center, 
    mode  = "out" 
  )[[1]]
  
  # 2. Create an induced subgraph from that set of vertices
  sub_g <- induced_subgraph(graph, vids = vertices_in_range)
  
  # Return the induced subgraph
  return(sub_g)
}
#Helper to pull in a set of genes (vertices + their edges) from a source graph
add_vertices_and_edges <- function(target, source, genes) {
  v_attrs <- list.vertex.attributes(source)
  e_attrs <- list.edge.attributes(source)
  
  for (g in genes) {
    # --- add the vertex (with its attributes) if it isn't already there ---
    if (! (g %in% V(target)$name) ) {
      vals <- lapply(v_attrs, function(a) vertex_attr(source, a, which(V(source)$name == g)))
      names(vals) <- v_attrs
      target <- add_vertices(target, 1, attr = vals)
    }
    
    # --- pull in every edge incident on g, if both ends now live in target ---
    inc_edges <- incident(source, g, mode = "all")
    for (e in inc_edges) {
      ends_e <- ends(source, e)
      if (all(ends_e %in% V(target)$name)) {
        # extract edge‐attributes
        vals <- lapply(e_attrs, function(a) edge_attr(source, a, e))
        names(vals) <- e_attrs
        target <- add_edges(target, ends_e, attr = vals)
      }
    }
  }
  target
}
# helper to drop all but a whitelist of vertex attrs
prune_vertex_attrs <- function(g, keep) {
  to_drop <- setdiff(list.vertex.attributes(g), keep)
  for(a in to_drop) g <- delete_vertex_attr(g, a)
  g
}
# helper to build the reg vector
make_regulation <- function(vnames, down1, down2, up1, up2, 
                            tag_down1, tag_down2, tag_up1, tag_up2){
  sapply(vnames, function(g){
    tags <- c()
    if(g %in% down1) tags <- c(tags, tag_down1)
    if(g %in% down2) tags <- c(tags, tag_down2)
    if(g %in% up1)   tags <- c(tags, tag_up1)
    if(g %in% up2)   tags <- c(tags, tag_up2)
    if(length(tags)==0) tags <- "Cdc42"
    paste(tags, collapse = "_")
  }, USE.NAMES = FALSE)
}
