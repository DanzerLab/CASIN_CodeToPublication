        path_edges <- sp2$epath[[1]]
        all_edges <- c(all_edges, path_edges)
      }
    }
  }
  all_edges <- unique(all_edges)
  subgraph_g <- subgraph.edges(OPI_g, eids = all_edges, delete.vertices = TRUE)
