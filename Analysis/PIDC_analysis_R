# get interactions that are in PIDC and retraceable by databases with 0 bridges

new_PIDC_list <- list()
edges_list <- list()

# Loop over each PIDC network subset
for (i in seq_along(PIDC_list_rel)){
  
  PIDC_graph <- PIDC_list_rel[[i]]
  setName <- names(PIDC_list_rel)[i]
  plotTitle <- paste0("PIDC-DB: ", setName)
  
  # Extract edges from the PIDC graph
  edges  <- igraph::as_data_frame(PIDC_graph, what = "edges")
  
  # Build the initial gene set from PIDC genes
  geneSet <- unique(c(edges$from, edges$to))
  
  # Select the appropriate TF genes based on setName
  if(setName %in% c("ON24Casin_5perct_CasinPD", "ON24_5perct_CasinPD", "OFF24_5perct_CasinPD")){
    tf_genes <- tf_24MON_CasinPD
  } else if(setName %in% c("OFF24Casin_5perct_AgePD", "OFF24_5perct_AgePD", "ON24Casin_5perct_AgePD", "ON24_5perct_AgePD")){
    tf_genes <- tf_24MOFF_CasinAge
  }else{
    tf_genes <- tf_16MOFF_CasinAge
  }
  
  ## remove if not using only 24M PD related tfs
  #tf_genes <- intersect(tf_24MON_Casin,tf_24MON_noCasin)
  
  # Combine PIDC genes with TF genes
  geneSet <- unique(c(geneSet, tf_genes))
  # Always include "Cdc42"
  if (!('Cdc42' %in% geneSet)){
    geneSet <- c(geneSet, 'Cdc42')
  }
  
  # Get STRING interactions for the full gene set
  STRING_rows_df <- get_STRING_dataframe(string_db = string_db, geneSet = geneSet)
  STRING_rows_df_filtered <- anti_join(STRING_rows_df, combinedProteinRNA_df, 
                                       by = c("source_genesymbol" = "source_genesymbol", 
                                              "target_genesymbol" = "target_genesymbol"))
  
  # Combine database interactions and fill missing values
  database <- rbind(combinedProteinRNA_df, STRING_rows_df_filtered)
  database$consensus_stimulation[is.na(database$consensus_stimulation)] <- 0
  database$consensus_inhibition[is.na(database$consensus_inhibition)] <- 0
  
  # Build the full interaction graph from the database
  g <- interaction_graph(interactions = database)
  
  # Ensure "Cdc42" is present in PIDC_graph
  if (!('Cdc42' %in% V(PIDC_graph)$name)){
    PIDC_graph <- add_vertices(PIDC_graph, 1, name='Cdc42')
  }
  # Ensure tf genes is present in PIDC_graph
  tf_genes_missing <- setdiff(tf_genes, V(PIDC_graph)$name)
  if(length(tf_genes_missing) > 0){
    PIDC_graph <- add_vertices(PIDC_graph, nv = length(tf_genes_missing), name=tf_genes_missing)
  }
  
  
  # Set vertex attributes: label "Cdc42", "TF" or "Original"
  V(PIDC_graph)$gene_type <- NA
  V(PIDC_graph)$gene_type[V(PIDC_graph)$name == 'Cdc42'] <- 'Cdc42'
  V(PIDC_graph)$gene_type[V(PIDC_graph)$name %in% tf_genes] <- 'TF'
  V(PIDC_graph)$gene_type[is.na(V(PIDC_graph)$gene_type)] <- 'Original'
  
  # (A) Update Existing PIDC Edges with Adjusted Distance Calculation
  # Initialize columns for adjusted bridge count and the vertex path
  edges$nbridge <- NA
  edges$v_dist <- NA
  
  for (j in 1:nrow(edges)) {
    from_node <- edges$from[j]
    to_node <- edges$to[j]
    
    if (from_node %in% V(g)$name && to_node %in% V(g)$name) {
      sp <- shortest_paths(g, from = from_node, to = to_node, mode='all', output = "vpath")
      vpath <- names(sp$vpath[[1]])
      
      # Identify intermediate nodes (if any)
      if(length(vpath) > 2){
        intermediate <- vpath[2:(length(vpath)-1)]
      } else {
        intermediate <- character(0)
      }
      # Exclude any intermediate node that is a TF gene or "Cdc42"
      intermediate_filtered <- setdiff(intermediate, c(tf_genes, "Cdc42"))
      new_dist <- length(intermediate_filtered)
      
      edges$v_dist[j] <- paste(vpath, collapse = ", ")
      edges$nbridge[j] <- new_dist
    } else {
      edges$nbridge[j] <- 100
    }
  }
  
  # Label the edge as Found if no non-key (bridge) gene is needed
  edges$db_found <- ifelse(edges$nbridge == 0, "Found", "NotFound")
  
  # Update the PIDC_graph edges with the dbFound attribute
  for (j in 1:nrow(edges)) {
    from_node <- edges$from[j]
    to_node <- edges$to[j]
    
    edge_id <- get.edge.ids(PIDC_graph, c(from_node, to_node))
    if (edge_id > 0) {
      PIDC_graph <- set_edge_attr(PIDC_graph, "dbFound", index = edge_id, value = edges$db_found[j])
    }
  }
  
  # (B) Connect Key Genes (TFs and Cdc42) to Other Genes Using the Database
  # Define key genes as the union of TF genes and "Cdc42"
  key_genes <- unique(c("Cdc42", tf_genes))
  # Initialize a dataframe to record newly added edges
  new_edges <- data.frame(from=character(), to=character(), nbridge=integer(), v_dist=character(), db_found=character(), stringsAsFactors=FALSE)
  
  # For each key gene, check connectivity to every other gene in the PIDC graph
  for (source_gene in key_genes) {
    for (target_gene in setdiff(V(PIDC_graph)$name, source_gene)) {
      if (source_gene %in% V(g)$name && target_gene %in% V(g)$name) {
        sp <- shortest_paths(g, from=source_gene, to=target_gene, mode='all', output='vpath')
        vpath <- V(g)[sp$vpath[[1]]]$name
        if (length(vpath) < 2) next  # Skip if no valid path exists
        
        # Identify intermediate nodes and filter out key genes
        if(length(vpath) > 2){
          intermediate <- vpath[2:(length(vpath)-1)]
        } else {
          intermediate <- character(0)
        }
        intermediate_filtered <- setdiff(intermediate, key_genes)
        new_dist <- length(intermediate_filtered)
        
        # Only add the connection if no non-key bridge is needed
        if (is.finite(new_dist) && new_dist == 0) {
          if (!are.connected(PIDC_graph, source_gene, target_gene)) {
            PIDC_graph <- add_edges(PIDC_graph, c(source_gene, target_gene))
          }
          edge_id <- get.edge.ids(PIDC_graph, c(source_gene, target_gene))
          PIDC_graph <- set_edge_attr(PIDC_graph, "dbFound", index = edge_id, value='Found')
          
          # Record this new connection
          new_edges <- rbind(new_edges, data.frame(
            from=source_gene, to=target_gene, nbridge=new_dist,
            v_dist=paste(vpath, collapse=', '), db_found='Found', stringsAsFactors=FALSE
          ))
        }
      }
    }
  }
  
  # Merge the new edges with the previously computed ones
  edges <- rbind(edges, new_edges)
  
  # Create a layout for plotting the graph
  layout <- create_layout(PIDC_graph, layout = "fr")
  new_PIDC_list[[setName]] <- PIDC_graph
  edges_list[[setName]] <- edges
  
  # Plot the graph using ggraph with updated aesthetics
  print(ggraph(layout) + 
          geom_edge_link(aes(color = factor(dbFound), start_cap = label_rect(node1.name),
                             end_cap = label_rect(node2.name)), 
                         arrow = arrow(type = "closed", length = unit(4, "mm"))) +
          geom_node_label(aes(label = name, fill=gene_type), size = 5, repel = FALSE, alpha = 0.6) +
          scale_fill_manual(values = c('Cdc42'='yellow', 'TF'='purple', 'Original'='blue'), name='Gene Type') +
          scale_edge_color_manual(values = c("Found" = "green", "NotFound" = "red"),
                                  name = "dbFound") +
          theme_graph() + 
          ggtitle(plotTitle) +
          theme(text = element_text(family = "Times", size = 15), 
                plot.title = element_text(family = "Times", size = 20)))
}

