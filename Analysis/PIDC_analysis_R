pathway_relGenes_list <- # see Objects
pidc_summary_list <- # see Objects
new_PIDC_list <- # see Objects
new_PIDC_list_Cdc42spec <- # see Objects
mouse = 10090
string_db <- STRINGdb$new(species=mouse,score_threshold=600, network_type="full", input_directory="")
combinedProteinRNA_df <- # omnipath RNA Protein

names(new_PIDC_list)
int_Graph_names <- c("ON24Casin_5perct_CasinPD", "ON24_5perct_CasinPD","OFF24_5perct_CasinPD") # PD Casin
int_Graph_names <- c("OFF16Casin_5perct_AgePD", "OFF16_5perct_AgePD","OFF6_5perct_AgePD") # Age Casin

new_Graph_list <- list()
dist_df_list <- list()

## for each interesting igraph object in new_PIDC_list
for(graph_name in int_Graph_names){
  ## subset relevant igraph objects from new_PIDC_list and new_PIDC_list_Cdc42spec
  int_graph <- new_PIDC_list[[graph_name]]
  int_graph_Cdc42spec <- new_PIDC_list_Cdc42spec[[graph_name]] 
  int_graph_Cdc42spec_new <- int_graph_Cdc42spec
  
  dist_df <- data.frame(
    graph   = character(),
    pathway = character(),
    gene    = character(),
    distance= numeric(),
    stringsAsFactors = FALSE
  )
  
  ## for each pathway
  for (path_name in names(pathway_relGenes_list)) {
    path_genes <- pathway_relGenes_list[[path_name]]
    path_genes_int <- intersect(path_genes, V(int_graph)$name)
    if (length(path_genes_int) == 0){## here we will add the check using STRING/omniPath i
      STRING_df <- get_STRING_dataframe(string_db = string_db, geneSet = c(path_genes, V(int_graph_Cdc42spec)$name))
      STRING_df_filtered <- anti_join(STRING_df, combinedProteinRNA_df, 
                                      by = c("source_genesymbol" = "source_genesymbol", 
                                             "target_genesymbol" = "target_genesymbol"))
      
      # Combine database interactions and fill missing values
      database_df <- rbind(combinedProteinRNA_df, STRING_df_filtered)
      database_df$consensus_stimulation[is.na(database_df$consensus_stimulation)] <- 0
      database_df$consensus_inhibition[is.na(database_df$consensus_inhibition)] <- 0
      database_df <- database_df[which(database_df$source_genesymbol %in% c(path_genes, V(int_graph_Cdc42spec)$name)|database_df$target_genesymbol %in% c(path_genes, V(int_graph_Cdc42spec)$name)),]
      # build an undirected igraph from the df
      db_graph <- graph_from_data_frame(
        d    = database_df %>% dplyr::select(source_genesymbol, target_genesymbol),
        directed = FALSE,
        vertices = unique(c(database_df$source_genesymbol,
                            database_df$target_genesymbol))
      )
      
      # pre‐compute the “original” graph's node set in the db_graph
      graph_nodes_in_db <- V(db_graph)[name %in% V(int_graph_Cdc42spec)$name]
      
      # for **each** pathway gene:
      for (g in path_genes) {
        if (!(g %in% V(db_graph)$name) || length(graph_nodes_in_db)==0) next
        
        # distances from g to every node that was in the original int_graph_Cdc42spec
        dvec <- distances(
          graph = db_graph,
          v     = V(db_graph)[name == g],
          to    = graph_nodes_in_db,
          mode  = "all"
        )[1, ]
        
        if (all(is.infinite(dvec))) next
        min_d <- min(dvec, na.rm = TRUE)
        
        # record it just like in the else branch
        dist_df <- rbind(dist_df, data.frame(
          graph    = graph_name,
          pathway  = path_name,
          gene     = g,
          distance = min_d,
          stringsAsFactors = FALSE
        ))
        
        # if that minimum distance is ≤2, pull in the actual shortest‐path
        if (min_d <= 2) {
          # pick the first (or any) target with that min distance
          tgt <- names(dvec)[which.min(dvec)]
          sp  <- shortest_paths(
            graph  = db_graph,
            from   = V(db_graph)[name == g],
            to     = V(db_graph)[name == tgt],
            mode   = "all",
            output = "both"
          )
          
          for (eid in sp$epath[[1]]) {
            verts <- ends(db_graph, eid)
            
            # ensure those vertices exist in the Cdc42‐spec graph
            for (vname in verts) {
              if (!(vname %in% V(int_graph_Cdc42spec_new)$name)) {
                int_graph_Cdc42spec_new <- add_vertices(
                  int_graph_Cdc42spec_new, 1, name = vname
                )
              }
            }
            
            # now add the edge if missing
            v1 <- which(V(int_graph_Cdc42spec_new)$name == verts[1])
            v2 <- which(V(int_graph_Cdc42spec_new)$name == verts[2])
            if (!are.connected(int_graph_Cdc42spec_new, v1, v2)) {
              attrs <- edge.attributes(db_graph, eid)
              int_graph_Cdc42spec_new <- add_edges(
                int_graph_Cdc42spec_new, c(v1, v2), attr = attrs
              )
            }
          }
        }
      }
      
    }else{
      # compute distances from each pathway gene to "Cdc42"
      dmat <- distances(
        graph = int_graph,
        v     = V(int_graph)[name %in% path_genes_int],
        to    = V(int_graph)[name == "Cdc42"],
        mode  = "all"
      )
      
      # flatten into a data.frame
      tmp_df <- data.frame(
        graph    = graph_name,
        pathway  = path_name,
        gene     = rownames(dmat),
        distance = as.numeric(dmat[,1]),
        stringsAsFactors = FALSE
      )
      
      # bind to this graph's df
      dist_df <- rbind(dist_df, tmp_df)
      
      ## save the edge from pathway gene to the bridge gene (or Cdc42)
      gene_corrDist <- tmp_df$gene[which(tmp_df$distance <= 2)]
      if (length(gene_corrDist) == 0) next
      
      # for each such gene, pull in the actual shortest‐path edges
      for (g in gene_corrDist) {
        sp <- shortest_paths(
          graph  = int_graph,
          from   = V(int_graph)[name == g],
          to     = V(int_graph)[name == "Cdc42"],
          mode   = "all",
          output = "both"
        )
        edge_ids <- sp$epath[[1]]
        
        # walk each edge in that path
        for (eid in edge_ids) {
          # get the two endpoint names
          verts <- ends(int_graph, eid)
          
          # ensure both vertices exist in the Cdc42‐spec graph
          for (vname in verts) {
            if (!(vname %in% V(int_graph_Cdc42spec_new)$name)) {
              int_graph_Cdc42spec_new <- add_vertices(int_graph_Cdc42spec_new, 1, name = vname)
            }
          }
          
          # now add the edge (if missing), copying all attributes
          v1 <- which(V(int_graph_Cdc42spec_new)$name == verts[1])
          v2 <- which(V(int_graph_Cdc42spec_new)$name == verts[2])
          if (!are.connected(int_graph_Cdc42spec_new, v1, v2)) {
            attrs <- edge.attributes(int_graph, eid)
            int_graph_Cdc42spec_new <- add_edges(
              int_graph_Cdc42spec_new,
              c(v1, v2),
              attr = attrs
            )
          }
        }
      }
    }
    
  } 
  # save into your list
  dist_df_list[[graph_name]] <- dist_df
  new_Graph_list[[graph_name]]  <- int_graph_Cdc42spec_new
}

