## Heatmap
data <- FetchData(seurat_integrated, vars = c("CellLevel1","sample", 
                                              "Mbp","Acsbg1","Inpp5d","Pdgfra","Cped1","Ttr",
                                              "Th","Slc17a6","Slc17a7","Gad1"), 
                  slot = "data")
## change group_by depending on which level we want
data_aggregated_CellLevel1 <- data %>%
  group_by(sample, CellLevel1) %>%
  summarise(across(.cols = -c(0), # Skip the first two columns
                   .fns = ~ mean(.x, na.rm = TRUE)),
            .groups = 'drop') %>%
  mutate(CellLevel1 = factor(CellLevel1, levels = c("Microglia","Astrocyte","Oligodendrocyte","OPC","Vascular Cell", "Choroid Plexus",
                                                    "Dopaminergic Neuron", "GABA Neuron", "Vglut2 Neuron", "Vglut1 Neuron"))) %>%
  arrange(CellLevel1)

CellLevel1_annotation <- data_aggregated_CellLevel1$CellLevel1

heatmap_matrix_CellLevel1 <- as.matrix(data_aggregated_CellLevel1[, -c(1:2)])
heatmap_matrix_CellLevel1 <- apply(heatmap_matrix_CellLevel1, 2, normalize_and_scale)
rownames(heatmap_matrix_CellLevel1) <- paste(data_aggregated_CellLevel1$sample, data_aggregated_CellLevel1$CellLevel1, sep = "_")

# Create row annotation
CellLevel1_ann <- HeatmapAnnotation(df = data.frame(CellLevel1 = CellLevel1_annotation),
                                    which = "row", # Specify this is a row annotation
                                    col = list(CellLevel1 = c("GABA Neuron" = "darkblue", "Vglut1 Neuron" = "darkred", "Vglut2 Neuron" = "palevioletred2",
                                                              "Dopaminergic Neuron" = "blueviolet","Astrocyte" = "springgreen4",
                                                              "Choroid Plexus" = "yellow3", "Microglia" = "plum3",
                                                              "Oligodendrocyte" = "violetred2", "OPC" = "#F941D0", "Vascular Cell" = "tan2")), 
                                    simple_anno_size = unit(0.5, "cm"),# Adjust the size as needed
                                    border = TRUE,
                                    show_legend = TRUE, show_annotation_name = FALSE) 


desired_column_order_CL1 <- c("Inpp5d","Acsbg1","Mbp","Pdgfra","Cped1","Ttr",
                              "Th","Gad1","Slc17a6","Slc17a7")
heatmap_matrix_CellLevel1 <- heatmap_matrix_CellLevel1[, desired_column_order_CL1]
breaks <- c(-4,-3,4)
colors <- c("grey10","grey20","yellow")
print(Heatmap(heatmap_matrix_CellLevel1,
              name = "Expression",
              row_names_gp = gpar(fontsize = 10),
              column_names_gp = gpar(fontsize = 10),
              show_row_names = FALSE,
              show_column_names = TRUE,
              show_row_dend = FALSE,
              cluster_rows = FALSE,
              cluster_columns = FALSE,
              row_title = "Celltype",
              use_raster = FALSE,
              left_annotation = CellLevel1_ann,
              col = colorRamp2(breaks, colors)) 
)

