go_MF_clustered <- go_list_clustered$MF

go_term_int <- c("structural constituent of cytoskeleton","proton transmembrane transporter activity",
                 "molecular function inhibitor activity", "GTPase activity", "electron transfer activity")
kegg_term_int <- c("Parkinson disease", "Ubiquitin mediated proteolysis", "Necroptosis",
                   "Apoptosis","Nucleocytoplasmic transport")

go_MF_int <- go_MF_clustered[which(go_MF_clustered$Description %in% go_term_int),]
kegg_int <- kegg_clustered[which(kegg_clustered$Term_Description %in% kegg_term_int),]

kegg2 <- kegg_int %>%
  rename(Term = Term_Description,
         Fold = Fold_Enrichment) %>%
  mutate(Source = "KEGG")

go2   <- go_MF_int %>%
  rename(Term = Description,
         Fold = FoldEnrichment) %>%
  mutate(Source = "GO:MF")

combined <- bind_rows(kegg2, go2)
order_levels <- combined %>%
  arrange(Source, Fold) %>%
  pull(Term) %>%
  unique()

combined <- combined %>%
  mutate(Term = factor(Term, levels = order_levels))

ggplot(combined, aes(x = Fold,
                     y = Term,
                     fill = Source)) +
  geom_col(position = position_dodge(width = 0.8)) +
  labs(x    = "Fold Enrichment",
       y    = "Term",
       fill = "Data type") +
  theme_minimal() +
  theme(
    axis.text.y = element_text(size = 10),
    legend.position = "top"
  )

