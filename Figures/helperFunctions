clusterEnrichedPathfindR <- function(enrichRes,
                                     kRange     = 2:10,
                                     method     = "average",
                                     plotK      = TRUE) {
  # deps
  require(cluster)   # for silhouette()
  require(dplyr)     # for mutate/group_by
  
  # 1) build list of gene sets per term (combine Up and Down regs)
  geneSets <- lapply(seq_len(nrow(enrichRes)), function(i) {
    genes_up   <- strsplit(enrichRes$Up_regulated[i],    "[, ]+")[[1]]
    genes_down <- strsplit(enrichRes$Down_regulated[i],  "[, ]+")[[1]]
    unique(c(genes_up, genes_down))
  })
  names(geneSets) <- enrichRes$ID
  
  # 2) Jaccard similarity matrix
  terms <- names(geneSets)
  n     <- length(terms)
  simMat <- matrix(NA, nrow = n, ncol = n,
                   dimnames = list(terms, terms))
  jaccard <- function(a, b) {
    length(intersect(a,b)) / length(union(a,b))
  }
  for (i in seq_len(n)) {
    for (j in seq_len(n)) {
      simMat[i,j] <- jaccard(geneSets[[i]], geneSets[[j]])
    }
  }
  
  # 3) hierarchical clustering on distance = 1 - sim
  distMat <- as.dist(1 - simMat)
  hc      <- hclust(distMat, method = method)
  
  # 4) pick best k by silhouette
  avgSil <- function(k) {
    
    tryCatch({
      cl <- cutree(hc, k = k)
      sil <- silhouette(cl, distMat)
      mean(sil[, "sil_width"])
    }, error = function(e) {
      warning(sprintf("k = %d failed: %s", k, e$message))
      NA_real_
    })
  }
  silVals <- sapply(kRange, avgSil)
  bestK   <- kRange[which.max(silVals)]
  
  if (plotK) {
    plot(kRange, silVals, type = "b",
         xlab = "Number of clusters k",
         ylab = "Avg. silhouette width",
         main = "Selecting k by silhouette")
    abline(v = bestK, lty = 2, col = "red")
  }
  
  # 5) cut tree, assign clusters
  clusters <- cutree(hc, k = bestK)
  resDF    <- as.data.frame(enrichRes, stringsAsFactors = FALSE)
  resDF$cluster <- clusters[ resDF$ID ]
  
  # 6) label Representative vs Member by Fold_Enrichment
  resDF <- resDF %>%
    group_by(cluster) %>%
    mutate(status = if_else(
      Fold_Enrichment == max(Fold_Enrichment),
      "Representative",
      "Member"
    )) %>%
    ungroup()
  
  return(resDF)
}
clusterGOsem <- function(eGoRes,
                         ont,
                         OrgDb       = org.Mm.eg.db,
                         keytype     = "SYMBOL",
                         measure     = "Wang",
                         kRange      = 2:10) {
  # required packages
  require(GOSemSim)
  require(cluster)
  require(dplyr)
  
  # 1. build semantic data (compute IC only if needed)
  semData <- godata(OrgDb,
                    ont       = ont,
                    keytype   = keytype,
                    computeIC = measure %in% c("Resnik","Lin","Jiang","Rel"))
  
  # 2. pairwise semantic sim matrix
  terms <- eGoRes$ID
  n     <- length(terms)
  simMat <- matrix(NA, nrow = n, ncol = n,
                   dimnames = list(terms, terms))
  for (i in seq_len(n)) {
    for (j in seq_len(n)) {
      simMat[i,j] <- termSim(terms[i], terms[j],
                             semData = semData,
                             method  = measure)
    }
  }
  
  # 3. hierarchical clustering on 1 − sim
  distMat <- as.dist(1 - simMat)
  hc      <- hclust(distMat, method = "average")
  
  # 4. pick best k by average silhouette width
  avgSil <- function(k) {
    tryCatch({
      cl <- cutree(hc, k = k)
      sil <- silhouette(cl, distMat)
      mean(sil[, "sil_width"])
    }, error = function(e) {
      warning(sprintf("k = %d failed: %s", k, e$message))
      NA_real_
    })
  }
  silVals <- sapply(kRange, avgSil)
  bestK   <- kRange[which.max(silVals)]
  
  # 5. cut tree and build result table
  clusters <- cutree(hc, k = bestK)
  resDF    <- as.data.frame(eGoRes)
  resDF$cluster <- clusters[resDF$ID]
  
  # 6. label "Representative" vs "Member"
  resDF <- resDF %>%
    group_by(cluster) %>%
    mutate(status = if_else(
      FoldEnrichment == max(FoldEnrichment),
      "Representative",
      "Member"
    )) %>%
    ungroup()
  
  return(resDF)
}
