normalize_and_scale <- function(x, min_val = -4, max_val = 4) {
  normalized_x = (x - min(x, na.rm = TRUE)) / (max(x, na.rm = TRUE) - min(x, na.rm = TRUE))
  scaled_x = normalized_x * (max_val - min_val) + min_val
  return(scaled_x)
}
